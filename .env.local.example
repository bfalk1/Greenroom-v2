# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (set after creating products in Stripe Dashboard)
STRIPE_GA_PRICE_ID=
STRIPE_VIP_PRICE_ID=
STRIPE_AA_PRICE_ID=
NEXT_PUBLIC_STRIPE_GA_PRICE_ID=
NEXT_PUBLIC_STRIPE_VIP_PRICE_ID=
NEXT_PUBLIC_STRIPE_AA_PRICE_ID=
# Annual (yearly interval, ~15% off, 12 months of credits upfront) — create
# with scripts/create-stripe-annual-prices.ts. Unset = the annual toggle's
# card path is unavailable for that tier.
NEXT_PUBLIC_STRIPE_GA_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_VIP_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_AA_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_CREDITS_50_PRICE_ID=
NEXT_PUBLIC_STRIPE_CREDITS_150_PRICE_ID=
NEXT_PUBLIC_STRIPE_CREDITS_400_PRICE_ID=

# Discounted VIP offers. Each is a Stripe coupon applied server-side at
# checkout; unset = that offer fails closed (503) instead of charging full
# price. /api/health/payments verifies both against the live Stripe API.
# Lifetime ($11.99/mo forever, password-gated /vip page): $6.00 off with
# duration = "forever" — create in the Stripe dashboard.
STRIPE_VIP_LIFETIME_COUPON_ID=
# First month ($5.99 first month, public /promo page + /pricing VIP card):
# $12.00 off with duration = "once" — create with
# scripts/create-stripe-first-month-coupon.ts.
STRIPE_VIP_FIRST_MONTH_COUPON_ID=

# PayPal (credit pack checkout). Optional — leave unset to disable PayPal
# entirely: the UI hides the button and the API routes return 503.
# All THREE server vars below are required before checkout enables — eCheck
# settlement and crash recovery depend on the signature-verified webhook, so
# register the webhook (subscribe to CHECKOUT.ORDER.APPROVED and the
# PAYMENT.CAPTURE.* events) before taking money.
# PAYPAL_ENV: "sandbox" (default) or "live".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Billing plan ids for subscriptions (create with scripts/create-paypal-plans.ts).
# Leave unset to offer PayPal for credit packs only.
PAYPAL_GA_PLAN_ID=
PAYPAL_VIP_PLAN_ID=
PAYPAL_AA_PLAN_ID=
# Discounted VIP offer plans (PayPal can't coupon a subscription, so each
# discount is its own plan). Unset = that offer's PayPal path fails closed.
# Lifetime: a plan billing $11.99/mo forever, created in the PayPal dashboard.
PAYPAL_VIP_LIFETIME_PLAN_ID=
# First month: paid trial cycle ($5.99 × 1) then $17.99/mo — create with
# scripts/create-paypal-first-month-plan.ts.
PAYPAL_VIP_FIRST_MONTH_PLAN_ID=
# Annual plans (YEAR interval, ~15% off, 12 months of credits granted per
# yearly sale) — create with scripts/create-paypal-annual-plans.ts. Unset =
# annual PayPal checkout fails closed for that tier.
PAYPAL_GA_ANNUAL_PLAN_ID=
PAYPAL_VIP_ANNUAL_PLAN_ID=
PAYPAL_AA_ANNUAL_PLAN_ID=
# Set to "true" to show the PayPal button. NEXT_PUBLIC_* vars are inlined at
# build time — set it in the same deploy as the server vars above.
NEXT_PUBLIC_PAYPAL_ENABLED=
# Set to "true" to show PayPal subscribe buttons on /pricing — requires the
# PAYPAL_*_PLAN_ID vars above (packs-only configs leave this unset).
NEXT_PUBLIC_PAYPAL_SUBSCRIPTIONS_ENABLED=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED in every deployed environment. The payout cron routes now fail
# CLOSED — if CRON_SECRET is unset/empty they reject all requests (they move
# real money). Set the same value here and in the Vercel Cron Authorization header.
CRON_SECRET=

# Rate limiting (Vercel KV / Upstash). Provided automatically by the Vercel KV
# integration. When unset, the limiter falls back to a best-effort in-memory
# window (fine for local dev; provision KV for production protection).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend (email)
RESEND_API_KEY=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Web Analytics query API — powers the admin dashboard's landing-page
# and VIP-promo conversion tiles. Visitor counts are already being collected
# by @vercel/analytics (mounted in app/layout.tsx); this token is only needed
# to READ them back. Create one at vercel.com/account/tokens with access to
# this project. Without it the dashboard drops those two tiles and every
# other metric (active users, purchases, credits, subscribers) still works.
VERCEL_ANALYTICS_TOKEN=
# Optional overrides — default to this project's own ids.
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Meta (Facebook) Pixel for ad attribution. Pixel ID from Meta Events Manager.
# Leave empty to disable entirely — no script is loaded, all events no-op.
NEXT_PUBLIC_META_PIXEL_ID=

# Google tag (gtag.js) for Google Ads conversion tracking. The "AW-..." id from
# your Google Ads tag setup. Leave empty to disable entirely — no script loads
# and no conversion events fire. Conversion-action labels (e.g. Purchase) are
# code constants in src/lib/googleAds.ts, not env — a new conversion action in
# Google Ads means a new label constant there.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# TikTok Pixel for ad attribution. Pixel ID (sdkid) from TikTok Events Manager
# > your pixel > Settings. Leave empty to disable entirely — no script is
# loaded, all events no-op.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Meta Conversions API (server-side events, dedup'd against the pixel).
# Token: Events Manager > pixel > Settings > Conversions API > Generate access
# token. Server-only secret. Empty = CAPI disabled (pixel still works alone).
# See docs/meta-capi-runbook.md.
META_CAPI_ACCESS_TOKEN=
# Test Events code (Events Manager > Test Events tab) — set LOCALLY only to
# see sends in near-real-time; never set in production.
META_CAPI_TEST_EVENT_CODE=
